# 工具链、编译产物、备份、官方 exe 对照样品 —— 加起来十几 GB，都能重新生成
_tools/

# 前端依赖与打包产物
app/node_modules/
app/dist/

# Tauri 生成的东西
app/src-tauri/gen/
app/src-tauri/target/

# 别人的参考源码，只在本地留一份，不往外发
ref/

# 本机私货：访问令牌、运行日志、下载缓存
modio-token.txt
*.log
app/data/
app/src-tauri/data/

# 密钥类文件，永远不要进版本库
.env
.env.*
*.pem
*.key
*.pfx
id_rsa*
secrets*
*token*.txt

# 根目录下的临时脚本（计划/排查用的一次性东西，不属于项目）
_tmp/

# 系统垃圾
Thumbs.db
desktop.ini
.DS_Store

# cargo tauri icon 顺带生成的移动端图标，Windows 版用不上，可随时重新生成
app/src-tauri/icons/android/
app/src-tauri/icons/ios/
